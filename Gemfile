source "https://rubygems.org"

# Matches the exact Jekyll + plugin versions GitHub Pages runs in production,
# so `bundle exec jekyll serve` locally behaves the same as the deployed site.
gem "github-pages", group: :jekyll_plugins

# Windows / JRuby compatibility (safe to leave in on macOS/Linux)
gem "wdm", "~> 0.1.1", platforms: [:mingw, :x64_mingw, :mswin]
